# ============================================================
# AIDG & KR System — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Core ---
AIDG_ENVIRONMENT=development
AIDG_DEBUG=true
AIDG_API_V1_PREFIX=/api/v1
AIDG_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# --- Infrastructure (local docker-compose defaults) ---
AIDG_DATABASE_URL=postgresql+asyncpg://aidg:aidg@localhost:5432/aidg
AIDG_REDIS_URL=redis://localhost:6379/0
AIDG_S3_ENDPOINT=http://localhost:9000
AIDG_S3_ACCESS_KEY=minioadmin
AIDG_S3_SECRET_KEY=minioadmin
AIDG_S3_BUCKET=aidg-documents

# --- Security / JWT (change in production!) ---
AIDG_JWT_SECRET=dev-insecure-change-me
AIDG_JWT_ALGORITHM=HS256
AIDG_ACCESS_TOKEN_EXPIRE_MINUTES=30
AIDG_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OIDC (Microsoft Entra ID) — enables POST /api/v1/auth/oidc/token ---
AIDG_OIDC_ENABLED=false
AIDG_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AIDG_OIDC_CLIENT_ID=
AIDG_OIDC_CLIENT_SECRET=
AIDG_OIDC_AUDIENCE=

# --- Seeding ---
AIDG_SEED_ADMIN_PASSWORD=admin1234!

# --- LLM providers ---
AIDG_DEEPSEEK_API_KEY=
AIDG_DEEPSEEK_BASE_URL=https://api.deepseek.com
AIDG_JINA_API_KEY=
AIDG_JINA_EMBEDDING_MODEL=jina-embeddings-v3
AIDG_JINA_EMBEDDING_BASE_URL=https://api.jina.ai/v1

# --- Speech-to-text (Qwen ASR primary; key pending) ---
AIDG_STT_PROVIDER=mock
AIDG_QWEN_ASR_API_KEY=
AIDG_QWEN_ASR_BASE_URL=
AIDG_AZURE_SPEECH_KEY=
AIDG_AZURE_SPEECH_REGION=
